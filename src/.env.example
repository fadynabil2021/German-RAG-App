# ── Application ──────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=CHANGE_ME_32CHARS   # Used for JWT signing (HS256)
ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated list

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/grag

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379/0

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://user:pass@localhost:5672//
CELERY_RESULT_BACKEND=redis://:password@localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_CONCURRENCY=4

# ── LLM Providers ────────────────────────────────────────────
GENERATION_BACKEND=openai          # openai | cohere
GENERATION_MODEL_ID=gpt-4o-mini
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_MODEL_SIZE=1536
OPENAI_API_KEY=sk-...
COHERE_API_KEY=                    # Optional

# ── Vector DB ────────────────────────────────────────────────
VECTORDB_BACKEND=qdrant            # qdrant | pgvector
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=                        # Leave blank to disable
LOG_LEVEL=INFO

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE_FREE=20
RATE_LIMIT_PER_MINUTE_PRO=200

# ── Flower ───────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME
